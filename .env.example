# Local development (npm run dev)
VITE_API_URL="http://localhost:4000/api"

# Production build uses .env.production (VITE_API_URL=/api)
# Works on nginx when /api is proxied to the backend.
#
# Netlify:
# 1) Commit public/_redirects + netlify.toml (SPA + optional /api proxy)
# 2) In Netlify → Site configuration → Environment variables (Production):
#    VITE_API_URL=https://YOUR-BACKEND-DOMAIN/api
#    (or keep /api if netlify.toml proxy URL matches your backend)
# 3) Trigger "Clear cache and deploy site"
#
# Optional explicit production URL:
# VITE_API_URL="https://rwasikh.com/api"

VITE_GOOGLE_MAPS_API_KEY=
